<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".WarningScreen">

    <!-- Top Green Header Bar -->
    <View
        android:id="@+id/topHeaderBar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="#164E29"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Back Arrow Button -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Back"
        android:focusable="true"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintBottom_toBottomOf="@id/topHeaderBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/topHeaderBar"
        app:tint="#FFFFFF" />

    <!-- BCMS Connect Logo -->

    <!-- Warning Header Title -->

    <!-- Info Icon -->

    <ImageView
        android:id="@+id/logo"
        android:layout_width="86dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:contentDescription="BCMS Connect"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/topHeaderBar"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/topHeaderBar"
        app:srcCompat="@drawable/bcms_logo" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="Warning"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/topHeaderBar"
        app:layout_constraintEnd_toStartOf="@id/btnInfo"
        app:layout_constraintHorizontal_bias="0.153"
        app:layout_constraintStart_toEndOf="@id/logo"
        app:layout_constraintTop_toTopOf="@id/topHeaderBar"
        app:layout_constraintVertical_bias="0.511" />

    <ImageView
        android:id="@+id/btnInfo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/ic_launcher_background"
        android:contentDescription="Info"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="@id/topHeaderBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/topHeaderBar"
        app:srcCompat="@android:drawable/ic_menu_info_details"
        app:tint="#164E29" />

    <!-- Current Warning Level Title -->
    <TextView
        android:id="@+id/tvCurrentWarningTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:text="Current Warning Level"
        android:textColor="#000000"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topHeaderBar" />

    <!-- Warning Gauge Container (Card / Layout) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardWarningOverview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCurrentWarningTitle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Gauge visual placeholder / mockup using circular layout or drawing -->
            <FrameLayout
                android:id="@+id/gaugeLayout"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Outer ring background / progress simulation -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:drawable/presence_busy" />

                <!-- Inner white circle -->
                <androidx.cardview.widget.CardView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="48dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:textStyle="bold"
                            android:text="2"
                            android:textColor="#000000"
                            android:textSize="36sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="of 3"
                            android:textColor="#666666"
                            android:textSize="14sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Right side text details -->
            <TextView
                android:id="@+id/tvYouAreAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif"
                android:text="You are at"
                android:textColor="#333333"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@id/gaugeLayout"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvLevel2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:text="LEVEL 2"
                android:textColor="#164E29"
                android:textSize="22sp"
                app:layout_constraintStart_toEndOf="@id/gaugeLayout"
                app:layout_constraintTop_toBottomOf="@id/tvYouAreAt" />

            <TextView
                android:id="@+id/tvWarningDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif"
                android:text="Please follow the cleanliness rules to avoid penalty."
                android:textColor="#555555"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/gaugeLayout"
                app:layout_constraintTop_toBottomOf="@id/tvLevel2" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Warning History Title -->
    <TextView
        android:id="@+id/tvWarningHistoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:text="Warning History"
        android:textColor="#000000"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardWarningOverview" />

    <!-- History Card 1: Level 2 Warning -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardHistory1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="10dp"
        app:cardElevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWarningHistoryTitle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivIcon1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/stat_notify_error"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#F39C12" />

            <TextView
                android:id="@+id/tvHistoryTitle1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:text="Level 2 Warning"
                android:textColor="#000000"
                android:textSize="15sp"
                app:layout_constraintEnd_toStartOf="@id/ivArrow1"
                app:layout_constraintStart_toEndOf="@id/ivIcon1"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvHistorySub1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Improper waste disposal"
                android:textColor="#333333"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/ivArrow1"
                app:layout_constraintStart_toEndOf="@id/ivIcon1"
                app:layout_constraintTop_toBottomOf="@id/tvHistoryTitle1" />

            <TextView
                android:id="@+id/tvHistoryDate1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="May 15, 2024 | 09:30 AM"
                android:textColor="#888888"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/ivArrow1"
                app:layout_constraintStart_toEndOf="@id/ivIcon1"
                app:layout_constraintTop_toBottomOf="@id/tvHistorySub1" />

            <ImageButton
                android:id="@+id/ivArrow1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="View detail"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_play"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#888888" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- History Card 2: Level 1 Warning -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardHistory2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="10dp"
        app:cardElevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardHistory1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivIcon2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/stat_notify_error"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#27AE60" />

            <TextView
                android:id="@+id/tvHistoryTitle2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:text="Level 1 Warning"
                android:textColor="#000000"
                android:textSize="15sp"
                app:layout_constraintEnd_toStartOf="@id/ivArrow2"
                app:layout_constraintStart_toEndOf="@id/ivIcon2"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvHistorySub2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Not following collection schedule"
                android:textColor="#333333"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/ivArrow2"
                app:layout_constraintStart_toEndOf="@id/ivIcon2"
                app:layout_constraintTop_toBottomOf="@id/tvHistoryTitle2" />

            <TextView
                android:id="@+id/tvHistoryDate2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Apr 10, 2024 | 08:15 AM"
                android:textColor="#888888"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/ivArrow2"
                app:layout_constraintStart_toEndOf="@id/ivIcon2"
                app:layout_constraintTop_toBottomOf="@id/tvHistorySub2" />

            <ImageButton
                android:id="@+id/ivArrow2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="View detail"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_play"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#888888" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- History Card 3: Level 3 Warning -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardHistory3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="10dp"
        app:cardElevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardHistory2">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivIcon3"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/stat_notify_error"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#E74C3C" />

            <TextView
                android:id="@+id/tvHistoryTitle3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:text="Level 3 Warning"
                android:textColor="#000000"
                android:textSize="15sp"
                app:layout_constraintEnd_toStartOf="@id/ivArrow3"
                app:layout_constraintStart_toEndOf="@id/ivIcon3"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvHistorySub3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:text="(Known as Final Warning)"
                android:textColor="#C0392B"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/ivArrow3"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@id/ivIcon3"
                app:layout_constraintTop_toBottomOf="@id/tvHistoryTitle3" />

            <TextView
                android:id="@+id/tvHistoryDate3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Mar 05, 2024 | 10:20 AM"
                android:textColor="#888888"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/ivArrow3"
                app:layout_constraintStart_toEndOf="@id/ivIcon3"
                app:layout_constraintTop_toBottomOf="@id/tvHistorySub3" />

            <ImageButton
                android:id="@+id/ivArrow3"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="View detail"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_play"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#888888" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Warning Alert Banner -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBottomAlert"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#FADBD8"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardHistory3">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:text="If Warning Level 3 is reached, the Barangay Office will be notified."
            android:textColor="#900C3F"
            android:textSize="13sp" />
    </androidx.cardview.widget.CardView>

    <!-- Back to Dashboard Footer Button -->
    <LinearLayout
        android:id="@+id/btnBackToDashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Back icon"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#164E29" />

        <TextView
            android:id="@+id/tvBackToDashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="Back to Dashboard"
            android:textColor="#164E29"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>