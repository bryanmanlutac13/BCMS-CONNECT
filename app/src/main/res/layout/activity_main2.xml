<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2">

    <EditText
        android:id="@+id/editTextText3"
        android:layout_width="290dp"
        android:layout_height="83dp"
        android:ems="10"
        android:inputType="text"
        android:text="Name"
        tools:layout_editor_absoluteX="60dp"
        tools:layout_editor_absoluteY="298dp" />

    <EditText
        android:id="@+id/editTextText4"
        android:layout_width="290dp"
        android:layout_height="83dp"
        android:ems="10"
        android:inputType="text"
        android:text="Password"
        tools:layout_editor_absoluteX="60dp"
        tools:layout_editor_absoluteY="390dp" />

    <Button
        android:id="@+id/button"
        android:layout_width="300dp"
        android:layout_height="81dp"
        android:backgroundTint="#4CAF50"
        android:text="Login"
        tools:layout_editor_absoluteX="60dp"
        tools:layout_editor_absoluteY="553dp" />

    <Button
        android:id="@+id/button2"
        android:layout_width="218dp"
        android:layout_height="41dp"
        android:backgroundTint="#FFFFFF"
        android:text="Forgot Password?"
        android:textColor="#4CAF50"
        android:textSize="15sp"
        tools:layout_editor_absoluteX="170dp"
        tools:layout_editor_absoluteY="484dp" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="190dp"
        android:layout_height="142dp"
        android:src="@drawable/bcms_logo"
        tools:layout_editor_absoluteX="110dp"
        tools:layout_editor_absoluteY="16dp" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="246dp"
        android:layout_height="52dp"
        android:layout_marginEnd="80dp"
        android:text="Barangay Cleanliness Monitoring System"
        android:textAlignment="center"
        android:textColor="#4CAF50"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout_editor_absoluteY="169dp" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome Back!"
        android:textColor="#2196F3"
        android:textSize="20sp"
        tools:layout_editor_absoluteX="136dp"
        tools:layout_editor_absoluteY="221dp" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="192dp"
        android:layout_height="22dp"
        android:text="Please login to continue"
        android:textAlignment="center"
        android:textSize="16sp"
        tools:layout_editor_absoluteX="106dp"
        tools:layout_editor_absoluteY="255dp" />

    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remember me"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="484dp" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="213dp"
        android:layout_height="55dp"
        android:text="No registered account. Please contact the Barangay Office."
        android:textAlignment="center"
        android:textSize="16sp"
        tools:layout_editor_absoluteX="96dp"
        tools:layout_editor_absoluteY="679dp" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="209dp"
        android:layout_height="32dp"
        android:text="Don't have an account?"
        android:textAlignment="center"
        android:textSize="18sp"
        tools:layout_editor_absoluteX="40dp"
        tools:layout_editor_absoluteY="634dp" />

    <Button
        android:id="@+id/button4"
        android:layout_width="145dp"
        android:layout_height="38dp"
        android:backgroundTint="#FFFFFF"
        android:text="Sign up here"
        android:textColor="#4CAF50"
        android:textSize="12sp"
        tools:layout_editor_absoluteX="243dp"
        tools:layout_editor_absoluteY="628dp" />


</androidx.constraintlayout.widget.ConstraintLayout>